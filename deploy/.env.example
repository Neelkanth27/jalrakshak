# JalRakshak Environment Configuration Template
# Copy this file to .env before starting containers:
# cp deploy/.env.example deploy/.env

# MQTT Configuration
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=jalrakshak/telemetry
MQTT_ALERTS_TOPIC=jalrakshak/alerts

# Telegram Bot Alert Dispatcher
# Obtain via Telegram @BotFather and @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Microservice Ports
API_PORT=8000
WEB_PORT=3000

APP_TIMEZONE=Asia/Kolkata
